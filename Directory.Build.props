<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- La versión sale en la barra de estado de la ventana: es lo primero que hay que preguntar
         cuando alguien cuenta que algo no le va.

         Aquí solo cuentan MAJOR.MINOR: el parche lo pone el CI al publicar, el siguiente al último
         tag, y lo pasa con -p:Version, así que la barra de estado, el ejecutable, el instalador y la
         release dicen el mismo número sin tocar nada. Para pasar a 1.2 o a 2.0 se cambia aquí, y la
         siguiente release sale como 1.2.0. Lo que se compila en local lleva el sufijo dev y se ve
         como v1.1.0-dev: no se puede confundir con una release. -->
    <VersionPrefix>1.1.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <Product>VibeScreen</Product>
    <Company>Sergio Sahuquillo</Company>
  </PropertyGroup>
</Project>
