<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-objetivo: el enumerador de puertos de Windows necesita el registro, que solo
         está en marco en el TFM de Windows. Evita arrastrar paquetes obsoletos y deja el
         mismo mecanismo montado para cuando entre LibreHardwareMonitor, que es Windows puro. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <TargetFramework></TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- Solo Windows: en Linux los sensores salen de sysfs. El acceso ring0 lo da PawnIO, que la librería usa pero no instala. -->
    <PackageReference Include="LibreHardwareMonitorLib" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeScreen.Protocol\VibeScreen.Protocol.csproj" />
    <!-- Por los avisos: lo que Core tiene que contarle a una persona viaja como código y datos, y
         quien lo enseña lo redacta en su idioma. Contracts no depende de nada. -->
    <ProjectReference Include="..\VibeScreen.Contracts\VibeScreen.Contracts.csproj" />
  </ItemGroup>

</Project>
